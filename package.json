{
  "name": "docwriter",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "description": "Offline paste-to-worldbible writing companion.",
  "author": {
    "name": "Banteee",
    "email": "riturajritu04@gmail.com"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:demo": "DOCWRITER_DB=data/demo.db node scripts/dev.mjs",
    "seed:demo": "DOCWRITER_DB=data/demo.db node server/seed-demo.mjs",
    "test": "node --test server/*.test.mjs",
    "bench": "node scripts/bench.mjs",
    "dev:server": "node --watch server/index.mjs",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.mjs",
    "desktop": "vite build && electron .",
    "desktop:dev": "DOCWRITER_DEV=1 electron .",
    "dist": "vite build && electron-builder --linux AppImage"
  },
  "dependencies": {
    "an-array-of-english-words": "^2.0.0",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "build": {
    "appId": "com.docwriter.app",
    "productName": "DocWriter",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "server/**/*",
      "dist/**/*",
      "package.json",
      "!**/*.map",
      "build/icon.png"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "synopsis": "Paste chapters, build a story bible",
      "description": "DocWriter is an offline writing companion: paste a chapter, it detects names, and you triage them into a typed, cross-linked worldbible. One file per book.",
      "syncDesktopName": true
    }
  },
  "license": "MIT",
  "homepage": "https://github.com/Rjbanti420/docwriter#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Rjbanti420/docwriter.git"
  },
  "desktopName": "docwriter.desktop"
}
